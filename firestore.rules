rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the owner's verified Google account may change anything.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'rb@kabaniconsulting.com'
        && request.auth.token.email_verified == true;
    }

    function ok(s) { return s is string && s.size() <= 160; }

    // Everyone may read the listings (the public Commodities page shows them).
    match /listings/{id} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.type in ['supply', 'demand']
        && ok(request.resource.data.commodity)
        && ok(request.resource.data.volume)
        && (!('origin' in request.resource.data) || ok(request.resource.data.origin))
        && (!('when' in request.resource.data) || ok(request.resource.data.when))
        && (!('port' in request.resource.data) || ok(request.resource.data.port))
        && (!('country' in request.resource.data) || ok(request.resource.data.country))
        && (!('added' in request.resource.data) || ok(request.resource.data.added))
        && (!('quality' in request.resource.data) || ok(request.resource.data.quality))
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 600));
      allow delete: if isOwner();
    }

    // Requests from visitors (Commodities page > Make a request). Anyone may send one; only the owner may read, decide or delete them.
    match /submissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'commodity', 'otherCommodity', 'origin', 'volume', 'quality', 'when', 'destination', 'details', 'name', 'company', 'email', 'phone', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['supply', 'demand']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 160
        && ok(request.resource.data.commodity) && ok(request.resource.data.volume)
        && (!('otherCommodity' in request.resource.data) || ok(request.resource.data.otherCommodity))
        && (!('origin' in request.resource.data) || ok(request.resource.data.origin))
        && (!('quality' in request.resource.data) || ok(request.resource.data.quality))
        && (!('when' in request.resource.data) || ok(request.resource.data.when))
        && (!('destination' in request.resource.data) || ok(request.resource.data.destination))
        && (!('company' in request.resource.data) || ok(request.resource.data.company))
        && (!('phone' in request.resource.data) || ok(request.resource.data.phone))
        && (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() <= 600));
      allow read, update, delete: if isOwner();
    }

    // Marker that tells the public page to show the live listings instead of the built-in ones.
    match /meta/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
